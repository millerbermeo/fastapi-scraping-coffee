# Copy to .env and adjust:  cp .env.example .env
# Read by docker compose (interpolation + injected into the container).

# --- Container runtime ------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
# Non-empty -> uvicorn runs with --reload (development). Empty -> production.
UVICORN_RELOAD=1

# --- Application settings (app/config.py, env_prefix "COFFEE_") -------------
COFFEE_APP_NAME="Coffee Price API"
COFFEE_APP_VERSION=1.0.0
COFFEE_DEBUG=false
COFFEE_CACHE_TTL_SECONDS=300
COFFEE_SCRAPER_TIMEOUT_MS=30000
COFFEE_SCRAPER_HEADLESS=true
